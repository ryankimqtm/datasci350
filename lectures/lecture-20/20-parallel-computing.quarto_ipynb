        "%timeit da.sqrt(da_data_large**2).mean().compute()"
      ],
      "id": "85348d59",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true
      },
      "source": [
        "#| echo: true\n",
        "#| eval: true\n",
        "# Dask with AUTO chunks \n",
        "da_data_auto = da.random.random(size, chunks='auto')\n",
        "%timeit da.sqrt(da_data_auto**2).mean().compute()"
      ],
      "id": "7da9f7b8",
